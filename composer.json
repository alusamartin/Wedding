{
    "name": "wpms/kenya-wedding",
    "description": "WPMS Kenya — Wedding Planning Management System (Kenyan Market Edition) v2.1",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "classmap": [
            "admin/include/"
        ],
        "files": [
            "admin/include/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WPMS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:db": "@php scripts/demo_reset.php --yes --db=wpms_test",
        "migrate:db-compat": "php scripts/migrate_mysqli_to_pdo.php",
        "lint": "@php scripts/lint.php admin",
        "code-audit": [
            "@php scripts/audit_db_object.php",
            "@php scripts/audit_static_calls.php",
            "@php scripts/audit_sql_columns.php",
            "@php scripts/audit_promises.php",
            "@php scripts/audit_enum_values.php",
            "@php scripts/audit_fixtures.php",
            "@php scripts/audit_unbound_sql.php",
            "@php scripts/audit_request_reads.php"
        ],
        "smoke": "@php scripts/smoke.php",
        "coverage": "@php scripts/coverage.php",
        "demo:reset": "@php scripts/demo_reset.php --yes",
        "ci": [
            "@lint",
            "@test:db",
            "@code-audit",
            "@php vendor/bin/phpunit --no-coverage"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
