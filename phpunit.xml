<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true">
    <testsuites>
        <testsuite name="WPMS Kenya">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!--
          The suite deliberately posts bad passwords (guard tests, wrong-CSRF
          tests, vendor logins...). With throttling live, those attempts would
          cross-lock the shared seeded accounts and break unrelated classes.
          LoginThrottleTest unsets this for its own process and strips it from
          its php -S child so it can test the throttle end-to-end.
        -->
        <env name="WPMS_LOGIN_THROTTLE_OFF" value="1"/>
    </php>
    <source>
        <include>
            <directory>admin/include</directory>
        </include>
    </source>
</phpunit>
