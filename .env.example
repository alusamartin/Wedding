[TEMPLATE]
# Everafter Planner — production secrets template
#
# HOW TO USE ON CPANEL:
#   1. Copy this file to `.env` and fill in the values.
#   2. Upload it to your account HOME (one level ABOVE public_html),
#      e.g. /home/USERNAME/.env — never inside the web root.
#   3. The app finds it automatically (admin/include/config.php loads
#      project-root/.env and HOME/.env). Any value also set in the real
#      server environment wins over this file.
#
# NEVER commit the real .env to git (.gitignore already excludes it).

# --- Database (from cPanel > MySQL Databases) -------------------------
WPMS_DB_HOST=localhost
WPMS_DB_USER=cpaneluser_wpms
WPMS_DB_PASS=CHANGE_ME_strong_password
WPMS_DB_NAME=cpaneluser_everafter

# --- Debug (MUST stay off in production) ------------------------------
# 1 = show PHP/DB errors on screen (dev machines only!)
WPMS_DEBUG=0

# --- Public base URL (no trailing slash) ------------------------------
# Used to build absolute links in emails, SMS texts and RSVP tokens.
WPMS_SITE_URL=https://yourdomain.co.ke

# --- Outbound email ----------------------------------------------------
# Off = every notification is only logged to tbl_mail_logs (retried later
# by the mail_retry cron). Turn on once you have a mail route in cPanel
# (Email Deliverability / an SMTP plugin relay).
WPMS_MAIL_ENABLED=0
WPMS_MAIL_FROM=no-reply@yourdomain.co.ke

# --- Weekly business pulse (scripts/business_pulse_email.php) ----------
# The owner's Monday brief: the platform's figures, the findings worth
# acting on and what to fix first, rendered from the same aggregates the AI
# tools read (no model writes it). Empty = every super admin with an address
# on file, each with their own tuned thresholds. Set one or more addresses
# (comma separated) to send it to a shared mailbox instead.
WPMS_PULSE_TO=

# --- M-Pesa Daraja -----------------------------------------------------
# C2B callback verification (typed transaction codes)
WPMS_MPESA_VERIFY=0
WPMS_MPESA_SHORTCODE=
WPMS_MPESA_CALLBACK_PASS=
# STK push (on-page "Pay by M-Pesa" prompts); sandbox until you go live
WPMS_MPESA_STK=0
WPMS_MPESA_STK_CONSUMER_KEY=
WPMS_MPESA_STK_CONSUMER_SECRET=
WPMS_MPESA_STK_SHORTCODE=
WPMS_MPESA_STK_PASSKEY=
WPMS_MPESA_STK_ENV=sandbox
WPMS_MPESA_STK_CALLBACK_PASS=

# --- SMS (Africa's Talking) --------------------------------------------
# Without a key every send is logged and counted but never transmitted (dev
# mode — the demo and test suite rely on that). Set both values to send for
# real; WPMS_AT_REQUIRE=1 refuses to pretend on an install that must not.
WPMS_AT_USERNAME=
WPMS_AT_API_KEY=
WPMS_AT_REQUIRE=0

# --- Subscriptions / trials -------------------------------------------
WPMS_SUB_AUTO_RENEW=0
WPMS_SUB_GRACE=1
# 180 days = the six-month free trial. The nurture emails (check-in at the
# halfway point, last call the day before expiry) scale with this number.
WPMS_TRIAL_DAYS=180
WPMS_TRIAL_NURTURE=0

# --- Kill switches -----------------------------------------------------
# 1 = disable login throttling (ONLY for maintenance; keep empty in prod)
WPMS_LOGIN_THROTTLE_OFF=
# 0 = the scheduled-job watchdog stops alerting (Job Health, v2.15). It
# silences the bell and the email only: the report, the non-zero exit of
# `php scripts/job_watch.php` and the Job Health page keep working, so the
# fact is never lost — only the interruption is. Empty/absent = alert.
WPMS_JOB_ALERTS=

# --- AI access over MCP (mcp.php, v2.16) -------------------------------
# The endpoint an AI client (Claude, ChatGPT, Cursor, an internal agent) is
# pointed at. It is only ever reachable WITH a token minted on
# admin/api_tokens.php, so these switches set the outer limits, not the door:
# leave them empty unless you have decided otherwise.
#   0 = switch the endpoint off entirely (503 to every client)
WPMS_MCP=
#   1 = allow tools that CHANGE data. Off by default, and off means a
#   write-scoped token is still read-only: no assistant can add a guest,
#   record a payment or tick a task, whatever its scopes say. Tier 3 (an SMS
#   to a guest list, a payment, an M-Pesa deposit prompt, a planner
#   assignment) additionally needs a signed-in planner's approval on
#   admin/mcp_approvals.php, whether or not this switch is on.
WPMS_MCP_WRITES=
#   Extra browser origins allowed to call the endpoint, comma separated.
#   Server-side clients (Claude Code, curl, an internal agent) send no
#   Origin and need no entry; the site's own origin is always allowed.
WPMS_MCP_ORIGINS=
#   The HMAC key behind a Tier-3 approval (v2.17). SET THIS — 32+ random
#   characters — and keep it out of git: it is what makes an approval string
#   unforgeable and unmovable. Left empty, the key is derived from this
#   install's own database credentials, which works but cannot be rotated
#   without also changing a database password. Rotating it simply invalidates
#   every approval outstanding at that moment.
WPMS_MCP_APPROVAL_SECRET=

# --- Per-planner scoping (ON by default) -------------------------------
# Who sees which wedding. With this on (the default), a planner sees the
# weddings whose `tblweddingbook.organizer_id` is their own id plus the ones
# nobody has been assigned yet, and a super admin sees every wedding. It is
# enforced in Helper.php and applied by the booking list, the enquiries
# ledger, the dashboard count, the MCP tools, and — through the web
# bootstrap in admin/include/init.php — every other staff page that names a
# `booking_id`.
#   0 = switch it off: every planner sees every booking and every enquiry
#       again, as builds before this feature did. Useful on a single-planner
#       install, or on a staging seed where one account owns everything.
# Anything else (empty, 1, on) leaves scoping ENABLED: the behaviour is the
# default, so forgetting this variable is safe, and switching it off only
# ever shows a planner MORE.
WPMS_PLANNER_SCOPING=

# --- Read replica for AI reads (OPTIONAL) ------------------------------
# Moves an assistant's READ traffic off the primary database: an agent asking
# a hundred questions should not compete with the couple signing in. Set HOST
# and the MCP read tools answer from here; USER, PASS and NAME default to the
# primary's values, which covers both a separate replica server and a second
# schema or read-only grant on the same server.
#   - Writes NEVER use this. Every write tool, the token check, the audit row
#     and a Tier-3 approval decision stay on WPMS_DB_*.
#   - EMPTY HOST = no replica, and that is the normal setting: the primary
#     serves reads and writes exactly as before (XAMPP, most cPanel plans).
#   - A configured replica that cannot be reached also falls back to the
#     primary and writes one line to the PHP error log; reads stay up.
#   - Replication lag is visible to the assistant: a row written a moment ago
#     may not appear in a read for a few seconds. Pair these credentials with
#     migrations/v2.18_mcp_grants.sql's read user so the assistant's
#     connection cannot write even if the code asked it to.
WPMS_DB_REPLICA_HOST=
WPMS_DB_REPLICA_USER=
WPMS_DB_REPLICA_PASS=
WPMS_DB_REPLICA_NAME=

# --- Cron bridge (ONLY if your plan has no Cron Jobs icon) -------------
# Long random key required by cron_bridge.php; leave empty to keep the
# endpoint fully disabled.
WPMS_CRON_BRIDGE_KEY=
